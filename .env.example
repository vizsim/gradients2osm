# Backblaze B2 credentials for uploading PMTiles via viz/preprocessing/upload_pmtiles.sh
#
# Create an Application Key at https://secure.backblaze.com/app_keys.htm
# Scope it to the target bucket with Read+Write permission (not the master key!).
# The applicationKey is shown only once — save it directly into your .env.
#
# Copy this file to `.env` (which is gitignored) and fill in the real values.

B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
